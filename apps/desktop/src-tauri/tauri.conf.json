{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "app",
  "version": "0.0.1",
  "identifier": "dev.vnote.app",
  "build": { "beforeDevCommand": "bun run dev", "devUrl": "http://localhost:1430", "beforeBuildCommand": "bun run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "app", "width": 1100, "height": 750 }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": ["deb", "appimage"], "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
