{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src",
    "vite.config.ts",
    "pwa.manifest.ts"
  ],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/adapters-web"
    },
    {
      "path": "../../packages/ui"
    }
  ]
}
